## 🎨 UI/UX 패턴 (Mesop MVP)

### 단순한 채팅 인터페이스
```python
import mesop as me

@me.stateclass
class ChatState:
    """간단한 채팅 상태"""
    messages: list[dict] = me.field(default_factory=list)
    current_input: str = ""
    processing: bool = False

def chat_page():
    """메인 채팅 페이지"""
    state = me.state(ChatState)
    
    with me.box(style=me.Style(height="100vh", display="flex", flex_direction="column")):
        # 메시지 영역
        with me.box(style=me.Style(flex_grow=1, overflow_y="auto")):
            for msg in state.messages:
                render_message(msg)
        
        # 입력 영역
        with me.box(style=me.Style(padding=me.Padding.all(16))):
            me.input(
                value=state.current_input,
                placeholder="메시지를 입력하세요...",
                on_input=on_input_change
            )
            me.button("전송", on_click=send_message, disabled=state.processing)

def render_message(msg: dict):
    """메시지 렌더링"""
    role_color = "#007bff" if msg["role"] == "user" else "#28a745"
    with me.box(style=me.Style(margin=me.Margin.all(8))):
        me.text(f"[{msg['role']}]: {msg['content']}", 
                style=me.Style(color=role_color))
```

## 🔄 비동기 처리 패턴

### 스트리밍 응답
```python
async def stream(self, query: str, session_id: str) -> AsyncIterable[Dict[str, Any]]:
    async for event in self._runner.run_async(
        user_id=self._user_id, 
        session_id=session.id, 
        new_message=content
    ):
        if event.is_final_response():
            yield {"is_task_complete": True, "content": response}
        else:
            yield {"is_task_complete": False, "updates": "Processing..."}
```

### 간단한 비동기 처리
```python
import asyncio
from typing import AsyncGenerator

async def stream_agent_response(user_input: str) -> AsyncGenerator[str, None]:
    """Agent 응답 스트리밍"""
    # 단계별 처리 시뮬레이션
    yield "요청을 분석하고 있습니다..."
    await asyncio.sleep(0.5)
    
    yield "관련 정보를 검색하고 있습니다..."
    await asyncio.sleep(1.0)
    
    # 실제 Agent 호출
    response = await agent.process_request(user_input)
    yield f"처리 완료: {response}"
```

## 🧪 테스트 패턴

### Agent 단위 테스트 (MVP)
```python
import pytest
from unittest.mock import Mock

def test_schedule_agent_basic():
    """기본적인 일정 생성 테스트"""
    client_mock = Mock()
    agent = ScheduleAgent(client_mock)
    
    # Mock OpenAI 응답 설정
    client_mock.chat.completions.create.return_value.choices[0].message = {
        "content": "일정이 생성되었습니다.",
        "tool_calls": [{"function": {"name": "create_schedule_event", "arguments": "{}"}}]
    }
    
    result = agent.process_request("내일 3시에 회의 잡아줘")
    assert "생성되었습니다" in result

@pytest.mark.asyncio
async def test_mcp_integration():
    """MCP 서버 연동 테스트"""
    agent = AgentWithMCP()
    
    # MCP 호출 테스트 (mock 사용)
    with patch('mcp.ClientSession.connect') as mock_connect:
        await agent._connect_mcp_servers()
        assert len(agent.mcp_sessions) > 0
```

## 📝 명명 규칙

### 파일 및 디렉토리 (MVP 단순화)
- **Agent 구현**: `agents/{domain}_agent.py`
- **MCP 연동**: `mcp_clients/{server}_client.py`  
- **도구 정의**: `tools/{domain}_tools.py`
- **UI 페이지**: `ui/{page}_page.py`
- **테스트**: `tests/test_{module_name}.py`

### 클래스 및 함수
- **Agent 클래스**: `{Domain}Agent` (예: `ScheduleAgent`)
- **MCP 클라이언트**: `{Server}MCPClient` (예: `CalendarMCPClient`)
- **도구 함수**: `create_{action}_tool` (예: `create_schedule_tool`)

