# 🛠️ Floe 개발 가이드라인 및 코딩 표준

## 🎯 Agent 구현 표준 (MVP)

### OpenAI Agents SDK 패턴
모든 Agent는 OpenAI Agents SDK를 기반으로 구현합니다.

```python
from openai import OpenAI
from typing import Dict, Any, List

class ScheduleAgent:
    """OpenAI Agents SDK 기반 일정 관리 에이전트"""
    
    def __init__(self, client: OpenAI):
        self.client = client
        self.agent_id = "schedule_agent"
        self.tools = [
            self._create_event_tool,
            self._check_conflicts_tool,
            self._suggest_time_tool
        ]
    
    def process_request(self, user_input: str, context: Dict[str, Any]) -> str:
        """사용자 요청 처리"""
        response = self.client.chat.completions.create(
            model="gpt-4",
            messages=[
                {"role": "system", "content": self._get_system_prompt()},
                {"role": "user", "content": user_input}
            ],
            tools=self.tools,
            tool_choice="auto"
        )
        return self._handle_response(response)
    
    def _get_system_prompt(self) -> str:
        return """당신은 일정 관리 전문 AI입니다. 
        사용자의 일정 요청을 분석하고 적절한 도구를 사용하여 처리하세요."""
```

### MCP 서버 연동 패턴
기존 MCP 서버들을 Agent의 도구로 활용합니다.

```python
import mcp
from mcp.client import Session

class AgentWithMCP:
    """MCP 서버를 활용하는 Agent 기본 패턴"""
    
    def __init__(self):
        self.mcp_sessions = {}
        self._connect_mcp_servers()
    
    async def _connect_mcp_servers(self):
        """필요한 MCP 서버들에 연결"""
        # 파일시스템 MCP
        self.mcp_sessions['filesystem'] = await mcp.ClientSession.connect(
            "filesystem-mcp-server"
        )
        
        # 데이터베이스 MCP  
        self.mcp_sessions['database'] = await mcp.ClientSession.connect(
            "sqlite-mcp-server"
        )
    
    async def call_mcp_tool(self, server: str, tool: str, params: Dict) -> Any:
        """MCP 서버의 도구 호출"""
        session = self.mcp_sessions[server]
        return await session.call_tool(tool, params)
```

