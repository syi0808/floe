## 🔧 도구(Tool) 구현 가이드 (MVP)

### OpenAI Function Calling 패턴
```python
def create_schedule_tool():
    """OpenAI Function Calling용 일정 생성 도구"""
    return {
        "type": "function",
        "function": {
            "name": "create_schedule_event",
            "description": "새로운 일정 이벤트를 생성합니다",
            "parameters": {
                "type": "object",
                "properties": {
                    "title": {"type": "string", "description": "일정 제목"},
                    "start_time": {"type": "string", "description": "시작 시간 (ISO 8601)"},
                    "end_time": {"type": "string", "description": "종료 시간 (ISO 8601)"},
                    "description": {"type": "string", "description": "상세 설명"}
                },
                "required": ["title", "start_time", "end_time"]
            }
        }
    }

async def execute_create_schedule_event(params: Dict[str, Any]) -> Dict[str, Any]:
    """실제 일정 생성 로직 (MCP 서버 활용)"""
    # MCP 캘린더 서버 호출
    result = await mcp_client.call_tool("calendar", "create_event", params)
    return {"success": True, "event_id": result.get("id")}
```

