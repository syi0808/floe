{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Floe operator model catalog",
  "type": "object",
  "required": ["schema_version", "revision", "version", "providers"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "capability_evidence": {
      "type": "object",
      "required": ["contract_version", "entries"],
      "properties": {
        "contract_version": {"const": 1},
        "entries": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "required": ["provider_id", "model_id", "endpoint", "facts"],
            "properties": {
              "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
              "model_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S+$"},
              "endpoint": {"type": "string", "format": "uri", "minLength": 1, "maxLength": 2048},
              "facts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "required": ["capability", "status", "provenance"],
                  "properties": {
                    "capability": {"enum": ["chat", "structured_output", "tool_proposals"]},
                    "status": {"enum": ["supported", "unsupported"]},
                    "provenance": {
                      "type": "object",
                      "required": ["source", "verified_at"],
                      "properties": {
                        "source": {"type": "string", "minLength": 1, "maxLength": 512},
                        "verified_at": {"type": "string", "format": "date-time"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "$comment": "Facts match exact provider_id, model_id, and canonical endpoint. Missing contract, entry, or fact means unknown. Only explicit supported or unsupported values carry provenance."
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["provider_id", "models"],
        "additionalProperties": true,
        "properties": {
          "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "models": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "required": ["model_id", "source"],
              "additionalProperties": true,
              "properties": {
                "model_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S+$"},
                "display_name": {"type": "string", "maxLength": 256},
                "deprecated": {"type": ["boolean", "null"]},
                "source": {"type": "string", "minLength": 1, "maxLength": 512},
                "metadata": {
                  "anyOf": [
                    {"type": "null"},
                    {
                      "type": "object",
                      "additionalProperties": true,
                      "required": ["provenance"],
                      "anyOf": [
                        {"required": ["context_window"], "properties": {"context_window": {"type": "integer"}}},
                        {"required": ["max_output_tokens"], "properties": {"max_output_tokens": {"type": "integer"}}},
                        {"required": ["capabilities"], "properties": {"capabilities": {"type": "array", "minItems": 1}}}
                      ],
                      "properties": {
                        "context_window": {"type": ["integer", "null"], "minimum": 1, "maximum": 10000000},
                        "max_output_tokens": {"type": ["integer", "null"], "minimum": 1, "maximum": 10000000},
                        "capabilities": {
                          "type": ["array", "null"],
                          "maxItems": 32,
                          "uniqueItems": true,
                          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
                        },
                        "provenance": {
                          "type": "object",
                          "required": ["source", "verified_at"],
                          "additionalProperties": true,
                          "properties": {
                            "source": {"type": "string", "minLength": 1, "maxLength": 512},
                            "verified_at": {"type": "string", "format": "date-time"}
                          }
                        }
                      },
                      "$comment": "When both limits are present, max_output_tokens must not exceed context_window. Go validation enforces this value relationship."
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$comment": "Unknown additive fields are ignored by this reader. Change schema_version for incompatible suggestion changes. Provider and model IDs are separate values. Model metadata capabilities remain descriptive; only the separately versioned capability_evidence contract informs Inference. Migrated suggestions have no verification timestamp, capability evidence, or limits."
}
