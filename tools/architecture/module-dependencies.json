{
  "schema_version": 1,
  "status": "canonical allowed dependency policy; current repository graph is read from Cargo manifests",
  "edge_semantics": "A -> B means A may directly depend on B public API at compile time; adapters implement owner-defined ports.",
  "contract_reference_note": "v0.3: naming a pure contract crate (kernel, agent_contract, context_contract) directly is not a violation for a crate whose own API or stored records carry those values. The composition root, the vault adapter and Actions are the cases: the app composes owners that trade in them, the vault stores agent sessions, tasks, settlements and dependencies, and an action records the Expert result and package that proposed it. Routing any of them through a module re-export would hide the dependency rather than remove it. This does not extend to protocol, which carries a wire, nor to any execution or storage implementation.",
  "target": [
    {
      "id": "kernel",
      "package": "floe-kernel",
      "path": "crates/contracts/kernel",
      "responsibility": "IDs, small shared values",
      "group": "contracts",
      "allowed_internal_dependencies": []
    },
    {
      "id": "context_contract",
      "package": "floe-context-contract",
      "path": "crates/contracts/context",
      "responsibility": "Source views, provenance, recipient types",
      "group": "contracts",
      "allowed_internal_dependencies": [
        "kernel"
      ]
    },
    {
      "id": "execution",
